<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde cloud et transfert d'appareil (Android 12+) : base Room et DataStore `settings` inclus ;
     fichiers téléchargés (files/downloads) exclus. cacheDir (cache de streaming, pochettes) n'est jamais
     sauvegardé par Android. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads" />
    </device-transfer>
</data-extraction-rules>
